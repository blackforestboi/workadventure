# Copy to .env.teapot, keep it outside version control, and replace every CHANGE_ME value.
DOMAIN=teapot.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
GRPC_PORT=50051
LOG_LEVEL=WARN
RESTART_POLICY=unless-stopped
DATA_DIR=./data
VERSION=latest
TEAPOT_IMAGE_TAG=beta

# WorkAdventure service secrets
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
ROOM_API_SECRET_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
ADMIN_API_TOKEN=CHANGE_ME
MAP_STORAGE_API_TOKEN=CHANGE_ME
MAP_STORAGE_AUTHENTICATION_STRATEGY=Bearer
MAP_STORAGE_ENABLE_BEARER_AUTHENTICATION=true
MAP_STORAGE_ENABLE_BASIC_AUTHENTICATION=false
MAP_STORAGE_ENABLE_DIGEST_AUTHENTICATION=false
MAP_STORAGE_AUTHENTICATION_USER=
MAP_STORAGE_AUTHENTICATION_PASSWORD=
MAP_STORAGE_AUTHENTICATION_TOKEN=CHANGE_ME_64_RANDOM_CHARACTERS
MAP_STORAGE_AUTHENTICATION_VALIDATOR_URL=

# Durable Teapot application records. URL-encode special characters in the password.
TEAPOT_POSTGRES_USER=teapot
TEAPOT_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_PASSWORD
TEAPOT_POSTGRES_DATABASE=teapot

# Separate HMAC key for one-time, proposal-bound browser approvals.
TEAPOT_MCP_APPROVAL_SECRET=CHANGE_ME_64_RANDOM_CHARACTERS

# Shared only between Play and the internal hosted subscription bridge (minimum 32 characters).
TEAPOT_AGENT_BRIDGE_SECRET=CHANGE_ME_64_RANDOM_CHARACTERS
# Pin the provider CLIs baked into the bridge image; update intentionally and test OAuth again.
TEAPOT_CODEX_CLI_VERSION=0.147.0-alpha.6.5
TEAPOT_CLAUDE_CODE_VERSION=2.1.220

# X OAuth 2.0 PKCE application
TEAPOT_X_CLIENT_ID=CHANGE_ME
TEAPOT_X_CLIENT_SECRET=
TEAPOT_X_BOOTSTRAP_USER_IDS=CHANGE_ME_X_USER_ID

# World/editor defaults
START_ROOM_URL=/~/maps/areas.wam
ENABLE_MAP_EDITOR=true
MAP_EDITOR_ALLOW_ALL_USERS=true
MAP_EDITOR_ALLOWED_USERS=
DISABLE_ANONYMOUS=true
ENABLE_CHAT=true
ENABLE_CHAT_UPLOAD=false
ENABLE_CHAT_ONLINE_LIST=true
ENABLE_CHAT_DISCONNECTED_LIST=true
ENABLE_TUTORIAL=false

# Required upstream defaults; tune these for the beta environment.
MINIMUM_DISTANCE=64
GROUP_RADIUS=48
MAX_PER_GROUP=4
MAX_USERNAME_LENGTH=20
STORE_VARIABLES_FOR_LOCAL_MAPS=true
REDIS_HOST=redis
PROMETHEUS_AUTHORIZATION_TOKEN=CHANGE_ME
JITSI_URL=meet.jit.si
JITSI_PRIVATE_MODE=false
JITSI_ISS=
SECRET_JITSI_KEY=
BBB_URL=
BBB_SECRET=
TURN_SERVER=
TURN_USER=
TURN_PASSWORD=
TURN_STATIC_AUTH_SECRET=
STUN_SERVER=stun:stun.l.google.com:19302
PLAYER_VARIABLES_MAX_TTL=-1
MAX_USERS_FOR_WEBRTC=4
LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional OpenID remains disabled; X is Teapot's admission identity.
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_CLIENT_ISSUER=
OPENID_PROFILE_SCREEN_PROVIDER=
OPENID_SCOPE=openid profile email
OPENID_USERNAME_CLAIM=
OPENID_LOCALE_CLAIM=
OPENID_LOGOUT_REDIRECT_URL=
FALLBACK_LOCALE=en-US

# Observability (optional for a small beta, recommended before public access)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DSN_FRONT=
SENTRY_DSN_PUSHER=
SENTRY_DSN_BACK=
SENTRY_DSN_MAPSTORAGE=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=beta
SENTRY_TRACES_SAMPLE_RATE=0

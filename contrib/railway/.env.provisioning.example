# Copy to .env.provisioning in this same directory. It is gitignored.
# Never paste either token into chat, source control, or a Railway service.

# Railway account token. The existing Memex project token is insufficient.
# The existing Memex project token is intentionally insufficient: it cannot create
# the separate tpot-world project.
RAILWAY_TOKEN=

# Cloudflare custom API token, scoped only to the tpot.world zone.
CLOUDFLARE_API_TOKEN=

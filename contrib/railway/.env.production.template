# Railway production-variable contract for the dedicated tpot-world project.
#
# Do not upload this file. In Railway, create the shared secrets listed below,
# seal them, and attach them only to the services named in the runbook. Values
# in ${ { ... } } notation are Railway reference variables; remove the space
# after ${ when entering them in the Railway UI.

# Shared secrets: generate once, seal, and share only with the listed services.
SECRET_KEY=<64+ random characters>                         # play, back, map-storage
ROOM_API_SECRET_KEY=<64+ random characters>                # play
ADMIN_API_TOKEN=<64+ random characters>                    # play, back
MAP_STORAGE_API_TOKEN=<64+ random characters>              # play, map-storage
MAP_STORAGE_AUTHENTICATION_TOKEN=<64+ random characters>   # play, map-storage
TEAPOT_MCP_APPROVAL_SECRET=<64+ random characters>         # play
TEAPOT_AGENT_BRIDGE_SECRET=<64+ random characters>         # play, teapot-agent-bridge

# Add these to play.
PORT=3000
NODE_ENV=production
PUSHER_URL=https://tpot.world/
FRONT_URL=https://tpot.world
ALLOWED_CORS_ORIGIN=https://tpot.world
BRAND_NAME=tpot.world
BRAND_SHORT_NAME=tpot
BRAND_DESCRIPTION=Organize your online world in tpot.world.
BRAND_AUTHOR=tpot.world team
BRAND_PROVIDER=tpot.world
BRAND_THEME_COLOR=#1B2A41
BRAND_WEBSITE_URL=https://tpot.world
# Optional deployment-specific asset URLs. Leave blank to use bundled defaults.
BRAND_LOGO_URL=
BRAND_LOADING_LOGO_URL=
BRAND_LOGIN_LOGO_URL=
BRAND_ERROR_LOGO_URL=
BRAND_ERROR_IMAGE_URL=
BRAND_LOADING_BACKGROUND_URL=
BRAND_PWA_BACKGROUND_URL=
BRAND_POWERED_BY_LOGO_URL=
BRAND_STATUS_ICON_URL=
BRAND_STATUS_CHARACTER_URL=
BRAND_STATUS_FONT_IMAGE_URL=
BRAND_STATUS_FONT_DATA_URL=
BRAND_FAVICON_URL=
BRAND_MANIFEST_ICON_URL=
BRAND_CARD_IMAGE_URL=
UPLOADER_URL=https://tpot.world/uploader
ICON_URL=https://tpot.world/icon
API_URL=back.railway.internal:50051
INTERNAL_MAP_STORAGE_URL=http://map-storage.railway.internal:3000
PUBLIC_MAP_STORAGE_URL=https://tpot.world/map-storage
REDIS_HOST=${ { Redis.REDISHOST } }
REDIS_PORT=${ { Redis.REDISPORT } }
REDIS_PASSWORD=${ { Redis.REDISPASSWORD } }
TEAPOT_DATABASE_URL=${ { Postgres.DATABASE_URL } }
TEAPOT_REQUIRE_PERSISTENCE=true
TEAPOT_MAP_STORAGE_WRITE_TOKEN=${ { shared.MAP_STORAGE_AUTHENTICATION_TOKEN } }
TEAPOT_MCP_PUBLIC_URL=https://tpot.world/mcp
TEAPOT_AGENT_BRIDGE_URL=http://teapot-agent-bridge.railway.internal:17375
TEAPOT_WOKA_STORAGE_DIRECTORY=/data/teapot-wokas
TEAPOT_WOKA_PUBLIC_BASE_URL=https://tpot.world
ENABLE_MAP_EDITOR=true
MAP_EDITOR_ALLOW_ALL_USERS=true
DISABLE_ANONYMOUS=true
ENABLE_CHAT=true
ENABLE_CHAT_UPLOAD=false
ENABLE_CHAT_ONLINE_LIST=true
ENABLE_CHAT_DISCONNECTED_LIST=true
ENABLE_TUTORIAL=false
START_ROOM_URL=/~/maps/areas.wam
MINIMUM_DISTANCE=64
MAX_PER_GROUP=4
MAX_USERNAME_LENGTH=20
STUN_SERVER=stun:stun.l.google.com:19302

# Add these to back.
PORT=8080
NODE_ENV=production
PLAY_URL=https://tpot.world
INTERNAL_MAP_STORAGE_URL=http://map-storage.railway.internal:3000
PUBLIC_MAP_STORAGE_URL=https://tpot.world/map-storage
MAP_STORAGE_URL=map-storage.railway.internal:50053
REDIS_HOST=${ { Redis.REDISHOST } }
REDIS_PORT=${ { Redis.REDISPORT } }
REDIS_PASSWORD=${ { Redis.REDISPASSWORD } }
ENABLE_MAP_EDITOR=true
ENABLE_CHAT=true
STORE_VARIABLES_FOR_LOCAL_MAPS=true
MINIMUM_DISTANCE=64
GROUP_RADIUS=48
MAX_PER_GROUP=4

# Add these to map-storage.
PORT=3000
NODE_ENV=production
API_URL=back.railway.internal:50051
STORAGE_DIRECTORY=/maps
PATH_PREFIX=/map-storage
PUSHER_URL=https://tpot.world/
ENABLE_BEARER_AUTHENTICATION=true
ENABLE_BASIC_AUTHENTICATION=false
ENABLE_DIGEST_AUTHENTICATION=false
AUTHENTICATION_TOKEN=${ { shared.MAP_STORAGE_AUTHENTICATION_TOKEN } }
MAP_STORAGE_API_TOKEN=${ { shared.MAP_STORAGE_API_TOKEN } }

# Add these to uploader. Redis is optional while chat uploads are disabled.
PORT=8080
NODE_ENV=production
UPLOADER_URL=https://tpot.world/uploader
REDIS_HOST=${ { Redis.REDISHOST } }
REDIS_PORT=${ { Redis.REDISPORT } }
REDIS_PASSWORD=${ { Redis.REDISPASSWORD } }
ENABLE_CHAT_UPLOAD=false

# Add these to teapot-mcp.
TEAPOT_MCP_HOST=0.0.0.0
TEAPOT_MCP_PORT=17374
TEAPOT_MCP_ALLOWED_HOSTS=tpot.world
TEAPOT_PUSHER_URL=http://play.railway.internal:3000/

# Add these to teapot-agent-bridge.
TEAPOT_AGENT_BRIDGE_HOST=0.0.0.0
TEAPOT_AGENT_BRIDGE_PORT=17375
TEAPOT_AGENT_AUTH_ROOT=/var/lib/teapot-agent-auth
TEAPOT_HOSTED_BRIDGE_HOST=0.0.0.0
TEAPOT_HOSTED_BRIDGE_PORT=17375
TEAPOT_CODEX_BRIDGE_HOST=0.0.0.0
TEAPOT_CODEX_BRIDGE_PORT=17375
TEAPOT_CODEX_AUTH_ROOT=/var/lib/teapot-agent-auth/codex
TEAPOT_CLAUDE_AUTH_ROOT=/var/lib/teapot-agent-auth/claude
TEAPOT_CLAUDE_CLI=claude

# Gateway is the only service with a public Railway domain/custom domain.
PORT=8080
